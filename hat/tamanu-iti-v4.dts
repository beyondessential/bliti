// spec: HAT
//
// The Tamanu Iti v4 HAT: the first SPI bus with the TPM on its second chip select, and the third I2C
// bus on GPIO22/23. Named by the HAT EEPROM, so the firmware loads it from the boot partition.
//
// The sensors on the I2C bus are left without a kernel driver, which would hold their addresses
// against anything reading them directly.

/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2712";

	fragment@0 {
		target = <&spi0>;
		__overlay__ {
			status = "okay";
		};
	};

	// The second chip select is the TPM's, so spidev must not claim it.
	fragment@1 {
		target = <&spidev1>;
		__overlay__ {
			status = "disabled";
		};
	};

	fragment@2 {
		target = <&spi0>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			tpm@1 {
				compatible = "tcg,tpm_tis-spi";
				reg = <1>;
				spi-max-frequency = <32000000>;
				status = "okay";
			};
		};
	};

	fragment@3 {
		target = <&i2c3>;
		__overlay__ {
			status = "okay";
			clock-frequency = <100000>;
			pinctrl-0 = <&rp1_i2c3_22_23>;
		};
	};
};
