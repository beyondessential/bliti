# Install to /etc/systemd/system/bliti-hostapd.service, and do not enable it.
#
# Runs hostapd on the configuration bliti renders to /etc/hostapd/bliti.conf,
# for the hotspot. bliti starts, restarts and stops it over D-Bus as the
# configuration document asks, after creating the access point interface it
# runs on, so it has no [Install] section and nothing else should start it.
#
# The hostapd package's own units do not fit: hostapd.service reads the one
# system-wide configuration, and is masked on the device so that it cannot come
# up on its own, and hostapd@.service reads /etc/hostapd/<interface>.conf where
# bliti's file is named for bliti.
#
# Forking, so that a start finishes once hostapd has set the interface up and
# gone to the background, which is what the applier waits for before bringing
# the station up.
[Unit]
Description=bliti hotspot access point
Documentation=man:hostapd(8)
# ap0 is the access point interface the device's hardware description names,
# and the one hostapd's configuration runs on. Waiting for its device means a
# start never races udev announcing the interface bliti has just created, and
# the hotspot goes down with the interface.
BindsTo=sys-subsystem-net-devices-ap0.device
After=sys-subsystem-net-devices-ap0.device

[Service]
Type=forking
PIDFile=/run/bliti-hostapd.pid
ExecStart=/usr/sbin/hostapd -B -P /run/bliti-hostapd.pid /etc/hostapd/bliti.conf
Restart=on-failure
RestartSec=2
