# Install to /etc/systemd/system/bliti-hostapd@.service, and do not enable it.
#
# Runs hostapd for the hotspot on the configuration bliti renders to
# /run/bliti/hostapd/<interface>.conf, one instance per access point interface:
# bliti-hostapd@ap0.service runs ap0. bliti starts, restarts and stops the
# instance over D-Bus as the configuration document asks, after creating the
# access point interface it runs on, so it has no [Install] section and nothing
# else should start it. One hotspot runs at a time, so at most one instance does.
#
# The hostapd package's own units do not fit: hostapd.service reads the one
# system-wide configuration, and is masked on the device so that it cannot come
# up on its own, and hostapd@.service reads /etc/hostapd/<interface>.conf where
# bliti's files live under /run.
#
# Forking, so that a start finishes once hostapd has set the interface up and
# gone to the background, which is what the applier waits for before bringing
# the station up.
[Unit]
Description=bliti hotspot access point on %i
Documentation=man:hostapd(8)
# The instance is the access point interface hostapd's configuration runs on.
# Waiting for its device means a start never races udev announcing the
# interface bliti has just created, and the hotspot goes down with the
# interface.
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
Type=forking
PIDFile=/run/bliti-hostapd-%i.pid
ExecStart=/usr/sbin/hostapd -B -P /run/bliti-hostapd-%i.pid /run/bliti/hostapd/%i.conf
Restart=on-failure
RestartSec=2
